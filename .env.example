# AquaTrace Environment Configuration

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aquatrace

# Backend
PROJECT_NAME=AquaTrace API
VERSION=1.0.0
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional Groq LLM Configuration (LangChain / LangGraph)
# Server-side only; never expose in frontend
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
